diff --git a/arch/arm64/configs/vendor/kona-perf_defconfig b/arch/arm64/configs/vendor/kona-perf_defconfig
index 5b64d89..c675ea6 100755
--- a/arch/arm64/configs/vendor/kona-perf_defconfig
+++ b/arch/arm64/configs/vendor/kona-perf_defconfig
@@ -1,3 +1,24 @@
+# Full section-mismatch analysis (traces the exact __init/__exit reference
+# chain instead of the abbreviated default report) to pin down section
+# mismatch warnings during the build.
+CONFIG_DEBUG_SECTION_MISMATCH=y
+# Useless on OP8 (no WiGig / TV tuner / USB webcam hardware): with modules off these
+# would be built in; the =m lines are switched off in place further down.
+# CONFIG_USB_GSPCA is not set
+# Devicetree overlay (fixes 19821/Makefile's CONFIG_ARCH_LITO typo in its non-overlay
+# branch — with this on, the correct dtbo-$(CONFIG_ARCH_KONA) branch is used instead,
+# matching luk1337 and LineageOS's own kona-perf_defconfig)
+CONFIG_BUILD_ARM64_DT_OVERLAY=y
+# Enable the CLD WLAN host driver (drivers/staging/qcacld-3.0, merged from
+# modules_and_devicetree by merge-wlan) — OnePlus's official kernel split
+# ships the source but drops this defconfig entry along with the two
+# drivers/staging/{Makefile,Kconfig} wiring lines added separately.
+CONFIG_QCA_CLD_WLAN=y
+CONFIG_QCA_CLD_WLAN_PROFILE="qca6390"
+# Rmnet perf/shs (techpack/data, merged from modules_and_devicetree by merge-data;
+# OnePlus ships them as modules, monolithic build needs them built-in)
+CONFIG_RMNET_PERF=y
+CONFIG_RMNET_SHS=y
 CONFIG_LOCALVERSION="-perf"
 # CONFIG_LOCALVERSION_AUTO is not set
 CONFIG_NO_HZ=y
@@ -105,7 +126,12 @@ CONFIG_PANIC_ON_REFCOUNT_ERROR=y
 CONFIG_OPLUS_FEATURE_UID_PERF=y
 #endif
 
-CONFIG_MODULES=y
+# Match XTD's fully monolithic build: disabling module support forces
+# every remaining tristate driver to built-in (or off) kernel-wide,
+# automatically. Simpler and more complete than flipping each driver's
+# config individually — also removes any m/y dependency-capping risk
+# (e.g. USB_GSPCA on VIDEO_V4L2) since 'm' is no longer a valid state.
+# CONFIG_MODULES is not set
 CONFIG_MODULE_UNLOAD=y
 CONFIG_MODVERSIONS=y
 CONFIG_MODULE_SIG=y
@@ -309,7 +335,7 @@ CONFIG_HDCP_QSEECOM=y
 CONFIG_QSEECOM=y
 CONFIG_UID_SYS_STATS=y
 CONFIG_OKL4_USER_VIRQ=y
-CONFIG_WIGIG_SENSING_SPI=m
+# CONFIG_WIGIG_SENSING_SPI is not set
 CONFIG_QTI_XR_SMRTVWR_MISC=y
 CONFIG_QTI_MAXIM_FAN_CONTROLLER=y
 CONFIG_SCSI=y
@@ -360,7 +386,7 @@ CONFIG_PPPOL2TP=y
 CONFIG_USB_RTL8152=y
 CONFIG_USB_LAN78XX=y
 CONFIG_USB_USBNET=y
-CONFIG_WIL6210=m
+# CONFIG_WIL6210 is not set
 CONFIG_WCNSS_MEM_PRE_ALLOC=y
 CONFIG_CLD_LL_CORE=y
 CONFIG_CNSS2=y
@@ -441,7 +467,7 @@ CONFIG_HW_RANDOM_MSM_LEGACY=y
 # CONFIG_DEVPORT is not set
 CONFIG_DIAG_CHAR=y
 CONFIG_MSM_ADSPRPC=y
-CONFIG_MSM_RDBG=m
+# CONFIG_MSM_RDBG is not set
 CONFIG_OKL4_PIPE=y
 CONFIG_I2C_CHARDEV=y
 CONFIG_I2C_QCOM_GENI=y
@@ -538,8 +564,8 @@ CONFIG_V4L_PLATFORM_DRIVERS=y
 CONFIG_MSM_CVP_V4L2=y
 CONFIG_MSM_NPU=y
 CONFIG_MSM_GLOBAL_SYNX=y
-CONFIG_DVB_MPQ=m
-CONFIG_DVB_MPQ_DEMUX=m
+# CONFIG_DVB_MPQ is not set
+# CONFIG_DVB_MPQ_DEMUX is not set
 CONFIG_DVB_MPQ_SW=y
 CONFIG_VIDEO_V4L2_VIDEOBUF2_CORE=y
 CONFIG_I2C_RTC6226_QCA=y
@@ -655,7 +681,7 @@ CONFIG_RMNET_IPA3=y
 CONFIG_RNDIS_IPA=y
 CONFIG_IPA3_MHI_PRIME_MANAGER=y
 CONFIG_IPA_UT=y
-CONFIG_MSM_11AD=m
+# CONFIG_MSM_11AD is not set
 CONFIG_USB_BAM=y
 CONFIG_QCOM_GENI_SE=y
 CONFIG_IPA3_REGDUMP=y
@@ -691,7 +717,7 @@ CONFIG_MSM_QBT_HANDLER=y
 CONFIG_QCOM_IPCC=y
 CONFIG_QCOM_LLCC=y
 CONFIG_QCOM_KONA_LLCC=y
-CONFIG_QCOM_LLCC_PERFMON=m
+# CONFIG_QCOM_LLCC_PERFMON is not set
 CONFIG_QCOM_MDT_LOADER=y
 CONFIG_QPNP_PBS=y
 CONFIG_QCOM_QMI_HELPERS=y
diff --git a/drivers/staging/Kconfig b/drivers/staging/Kconfig
index 8f615d1..3b7756b 100644
--- a/drivers/staging/Kconfig
+++ b/drivers/staging/Kconfig
@@ -126,4 +126,7 @@ source "drivers/staging/axis-fifo/Kconfig"
 
 #source "drivers/staging/erofs/Kconfig"
 
+# CLD WLAN host driver, merged from modules_and_devicetree by merge-wlan
+source "drivers/staging/qcacld-3.0/Kconfig"
+
 endif # STAGING
diff --git a/drivers/staging/Makefile b/drivers/staging/Makefile
index da6d9ad..f5be438 100644
--- a/drivers/staging/Makefile
+++ b/drivers/staging/Makefile
@@ -53,3 +53,6 @@ obj-$(CONFIG_SOC_MT7621)	+= mt7621-dts/
 obj-$(CONFIG_STAGING_GASKET_FRAMEWORK)	+= gasket/
 obj-$(CONFIG_XIL_AXIS_FIFO)	+= axis-fifo/
 #obj-$(CONFIG_EROFS_FS)		+= erofs/
+
+# CLD WLAN host driver, merged from modules_and_devicetree by merge-wlan
+obj-$(CONFIG_QCA_CLD_WLAN)	+= qcacld-3.0/
